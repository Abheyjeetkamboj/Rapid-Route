# =============================================================================
# RAPIDROUTE AI — ENVIRONMENT VARIABLES
# =============================================================================
# Configure these variables to connect RapidRoute to your Supabase PostgreSQL backend.
# If these variables are left empty or omitted, RapidRoute automatically runs
# in 100% functional DEMO MODE with local persistence (localStorage).

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anonymous API Key
VITE_SUPABASE_ANON_KEY=

